[Unit]
Description=Distribox storage management
After=local-fs.target
Before=docker.service
RequiresMountsFor=/var/lib/distribox

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /usr/local/libexec/distribox/storage_broker.py --prepare
ExecStart=/usr/bin/python3 /usr/local/libexec/distribox/storage_broker.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# This service must mount in the host namespace. Filesystem sandbox directives
# (ProtectSystem, PrivateTmp, etc.) would hide its mounts from Docker/libvirt.

[Install]
WantedBy=multi-user.target
