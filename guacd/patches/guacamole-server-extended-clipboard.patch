+void guac_vnc_cut_text(rfbClient* client, const char* text, int textlen) {
+    guac_client* gc = rfbClientGetClientData(client, GUAC_VNC_CLIENT_KEY);
+    guac_vnc_client* vnc_client = (guac_vnc_client*) gc->data;
+    guac_vnc_cut_text_with_encoding(client, text, textlen,
+            vnc_client->clipboard_reader);
+}
+
+void guac_vnc_cut_text_utf8(rfbClient* client, const char* text, int textlen) {
+    /* Extended Clipboard includes a terminating NUL in its wire length. */
+    if (textlen > 0 && text[textlen - 1] == '\0')
+        textlen--;
+    guac_vnc_cut_text_with_encoding(client, text, textlen, GUAC_READ_UTF8);
+}
