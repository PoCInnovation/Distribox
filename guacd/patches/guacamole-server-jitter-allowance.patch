Ignore network jitter when guacd estimates client processing lag.

diff --git a/src/libguac/user-handlers.c b/src/libguac/user-handlers.c
index b9013bc..2ae6711 100644
--- a/src/libguac/user-handlers.c
+++ b/src/libguac/user-handlers.c
@@ -103,6 +103,12 @@ static int64_t __guac_parse_int(const char* str) {
 
 /* Guacamole instruction handlers */
 
+/**
+ * Lag, in milliseconds, attributed to network jitter rather than to a slow
+ * client. Without it, jitter throttles the frame rate and image quality.
+ */
+#define GUAC_USER_JITTER_ALLOWANCE 300
+
 int __guac_handle_sync(guac_user* user, int argc, char** argv) {
 
     int frame_duration;
@@ -143,7 +149,8 @@ int __guac_handle_sync(guac_user* user, int argc, char** argv) {
         user->last_frame_duration = estimated_rtt;
 
         /* Calculate cumulative accumulated processing lag relative to server timeline */
-        int processing_lag = current - user->last_received_timestamp - estimated_rtt;
+        int processing_lag = current - user->last_received_timestamp
+            - estimated_rtt - GUAC_USER_JITTER_ALLOWANCE;
         if (processing_lag < 0)
             processing_lag = 0;
 
